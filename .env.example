# Copy this file to backend/.env and fill in your values.
# backend/.env is gitignored — never commit real secrets.

# ── ElevenLabs (voice agent) ─────────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_TOOL_IDS=

# ── Server ────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=*
PORT=8000

# ── Text chat — OpenRouter (primary, free models) ─────────────────────────────
OPENROUTER_API_KEY=
# Set to "anthropic" to use Anthropic instead of OpenRouter
# CHAT_PROVIDER=openrouter

# Default model (must appear in CHAT_MODELS list below)
CHAT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Comma-separated list — populates the model picker in the widget UI
CHAT_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,cohere/north-mini-code:free,nex-agi/nex-n2-pro:free,nvidia/nemotron-3.5-content-safety:free

# ── Text chat — Anthropic (optional fallback) ─────────────────────────────────
ANTHROPIC_API_KEY=
# CHAT_MODEL=claude-haiku-4-5-20251001   # example when using Anthropic

# ── OpenRouter analytics (optional) ──────────────────────────────────────────
# SITE_URL=https://your-dashboard.com
# SITE_NAME=Your Dashboard

# ── LiteLLM proxy — Pipeline 2 (local/private, opt-in via model picker) ───────
# No CHAT_PROVIDER needed. Backend auto-routes when user picks a LITELLM_MODELS model.
# Start proxy: uv run --with 'litellm[proxy]' litellm --model <model> --port 4000
LITELLM_API_KEY=
LITELLM_BASE_URL=http://localhost:4000
# Comma-separated model IDs served by the proxy — appended to the widget picker.
LITELLM_MODELS=
